{
  "name": "temple_donation",
  "version": "1.0.0",
  "description": "Temple Donation Management System",
  "main": "index.js",
  "dependencies": {
    "@ant-design/icons": "^6.1.0",
    "antd": "^6.3.3",
    "react": "^19.2.4",
    "react-dom": "^19.2.4"
  },
  "scripts": {
    "build:css": "sass temple_donation/public/js/temple_donation/styles.scss:temple_donation/public/js/temple_donation/styles.css && npx tailwindcss -i ./temple_donation/public/js/temple_donation/styles.css -o ./temple_donation/public/js/temple_donation/styles.css",
    "dev:css": "sass --watch temple_donation/public/js/temple_donation/styles.scss:temple_donation/public/js/temple_donation/styles.css"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.47",
    "sass": "^1.79.4",
    "tailwindcss": "^3.4.13"
  }
}
